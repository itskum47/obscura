# Multi-stage hardened runtime worker image for Obscura Next
FROM rust:1-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  cmake \
  clang \
  python3 \
  pkg-config \
  libssl-dev \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN cargo build --release -p obscura-cli --bin obscura && \
    cargo build --release -p obscura-worker --bin obscura-worker && \
    cargo build --release -p obscura-worker --bin obscura-runtime-worker

FROM debian:trixie-slim AS runtime

# Install minimal SSL runtime certificates, ca-certificates, and curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  libssl3 \
  curl \
  && rm -rf /var/lib/apt/lists/*

# Run as non-privileged system user
RUN groupadd -g 10001 obscura && \
  useradd -u 10001 -g obscura -s /bin/false -m obscura

COPY --from=builder /src/target/release/obscura /usr/local/bin/obscura
COPY --from=builder /src/target/release/obscura-worker /usr/local/bin/obscura-worker
COPY --from=builder /src/target/release/obscura-runtime-worker /usr/local/bin/obscura-runtime-worker

USER obscura:obscura
WORKDIR /home/obscura

ENV OBSCURA_STEALTH=1
ENV RUST_LOG=warn
ENV OBSCURA_WORKER_BIN=/usr/local/bin/obscura-worker
ENV OBSCURA_METRICS_PORT=9100

EXPOSE 9222
EXPOSE 9100

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD curl -sf ${OBSCURA_CDP_TOKEN:+-H "Authorization: Bearer $OBSCURA_CDP_TOKEN"} http://127.0.0.1:9222/json/version && curl -sf http://127.0.0.1:9100/health || exit 1

ENTRYPOINT ["/usr/local/bin/obscura"]
CMD ["serve", "--port", "9222", "--host", "0.0.0.0"]


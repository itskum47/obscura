# OBSCURA SERVICE CONFIGURATION (example only - never commit real secrets)

# Required for distributed control-plane service authentication.
# Must be at least 32 bytes and must not be "testsecret" or empty.
OBSCURA_SERVICE_BOOTSTRAP_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes

# Optional CDP authentication token (>= 32 bytes). Required when CDP binds
# to a non-loopback address.
OBSCURA_CDP_TOKEN=

# Mandatory metrics endpoint token in production. All metrics listeners fail closed
# and reject startup if this token is unset or empty when bound to non-loopback addresses.
# For local loopback development only, unauthenticated metrics can be enabled with OBSCURA_DEV_MODE=1.
OBSCURA_METRICS_TOKEN=replace-with-a-secure-metrics-token

# Explicit local development mode flag. When enabled (1/true), permits unauthenticated
# metrics solely on loopback addresses (127.0.0.1, ::1, localhost).
OBSCURA_DEV_MODE=0

# Allow private/loopback network access (development only).
OBSCURA_ALLOW_PRIVATE_NETWORK=0

# Database URL for control-plane/scheduler.
DATABASE_URL=postgres://obscura:change-me@127.0.0.1:5432/obscura

# NATS URL.
NATS_URL=nats://127.0.0.1:4222

# Worker binary path.
OBSCURA_WORKER_BIN=/usr/local/bin/obscura-runtime-worker
